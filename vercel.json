{
  "installCommand": "echo 'Keine Abhängigkeiten – npm install übersprungen'",
  "functions": {
    "api/*.js": {
      "maxDuration": 30
    }
  },
  "redirects": [
    {
      "source": "/journal/en/:slug",
      "destination": "/:slug",
      "permanent": true
    },
    {
      "source": "/journal/fr/:slug",
      "destination": "/:slug",
      "permanent": true
    },
    {
      "source": "/journal/:slug",
      "destination": "/:slug",
      "permanent": true
    },
    {
      "source": "/immobilien/ugc",
      "destination": "/portfolio",
      "permanent": true
    },
    {
      "source": "/portfolio.html",
      "destination": "/portfolio",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/immobilien",
      "destination": "/immobilien-showcase.html"
    },
    {
      "source": "/immobilien-en",
      "destination": "/immobilien-showcase-en.html"
    },
    {
      "source": "/portfolio",
      "destination": "/portfolio.html"
    }
  ]
}
