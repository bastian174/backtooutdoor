{
  "installCommand": "echo 'Keine Abhängigkeiten – npm install übersprungen'",
  "functions": {
    "api/*.js": {
      "maxDuration": 30
    }
  },
  "redirects": [
    {
      "source": "/journal/en/:slug",
      "destination": "/:slug",
      "permanent": true
    },
    {
      "source": "/journal/fr/:slug",
      "destination": "/:slug",
      "permanent": true
    },
    {
      "source": "/journal/:slug",
      "destination": "/:slug",
      "permanent": true
    },
    {
      "source": "/immobilien",
      "destination": "/optimist-prein",
      "permanent": true
    },
    {
      "source": "/immobilien-en",
      "destination": "/optimist-prein-en",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/px/:path*",
      "destination": "https://images.pexels.com/photos/:path*"
    },
    {
      "source": "/optimist-prein",
      "destination": "/immobilien-showcase.html"
    },
    {
      "source": "/optimist-prein-en",
      "destination": "/immobilien-showcase-en.html"
    },
    {
      "source": "/optimist-prein/agb",
      "destination": "/op-agb.html"
    }
  ],
  "headers": [
    {
      "source": "/px/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
